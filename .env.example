# Copy to .env — same file is used for local run, run.bat, and docker compose --env-file

# Optional: workspace root for logs, outputs, uploads, data (Docker Compose uses /work on the server)
# PROJECT_ROOT=

# Optional: override SQLite default (sqlite:///.../data/app.db)
# DATABASE_URL=

LOG_LEVEL=INFO
CHART_DPI=300

RAG_RED_RISK=5
RAG_AMBER_RISK=3
RAG_RED_SV=-10
RAG_AMBER_SV=-5

# API route prefix (FastAPI). Frontend always prefixes requests with this path after VITE_API_URL.
API_PREFIX=/api/v1
# Browser origins allowed to call the API (include every host:port you use for Vite, e.g. localhost vs 127.0.0.1).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# --- Frontend (Vite) ---
# Copy `frontend/.env.example` to `frontend/.env` for local UI. VITE_API_URL must be the API origin only
# (e.g. http://127.0.0.1:8000) with NO trailing slash and NO /api/v1 — the app adds API_PREFIX in code.

# Public site URLs (used in branding file URLs and documentation). Optional; can also be set in Admin → Branding.
# PUBLIC_API_URL=https://api.example.com
# PUBLIC_APP_URL=https://app.example.com

# Branding uploads: max size per file (MB). Images may be compressed server-side.
# BRANDING_MAX_UPLOAD_MB=5

# Project data uploads (status tracker, RAID, weekly history): max size per file (MB).
# PROJECT_UPLOAD_MAX_MB=30

# Metrics snapshots (DB + JSON mirror): written under <repo>/outputs/snapshots/<project_id>/ (see API GET …/metrics/snapshots).

# JWT (set JWT_SECRET_KEY in any shared environment)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# Optional: Fernet key (44-char url-safe base64) used only to encrypt SMTP passwords stored in the database.
# If unset, a key is derived from JWT_SECRET_KEY (rotating JWT will make existing stored SMTP passwords undecryptable).
# EMAIL_ENCRYPTION_KEY=
# Short-lived access token (minutes). Legacy: JWT_EXPIRE_MINUTES still read as this value.
JWT_ACCESS_EXPIRE_MINUTES=30
# Refresh token lifetime (days)
JWT_REFRESH_EXPIRE_DAYS=7

# --- Admin login (use these on /login in the browser) ---
# This account is created on API startup if this email is NOT yet registered (even if other users exist).
# Put .env in the repository root (same folder as run.py) OR in backend/.env — both are loaded.
# After changing ADMIN_PASSWORD, either reset the password for that user or delete data\app.db for a clean DB.
# If login still fails: restart the API so settings reload; check you are using the exact email (case-insensitive).
ADMIN_EMAIL=admin@projectpilot.com
ADMIN_PASSWORD=ChangeMe123!

# Optional display name for the seeded admin
# BOOTSTRAP_ADMIN_NAME=Administrator

# Legacy names (same effect as ADMIN_EMAIL / ADMIN_PASSWORD if you prefer)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Dev only: include reset token in forgot-password JSON (never enable in production)
# DEV_RETURN_RESET_TOKEN=1
# With DEV_RETURN_RESET_TOKEN, set PUBLIC_APP_URL to your Vite origin (e.g. http://127.0.0.1:5173) so the API can
# return a ready-to-open reset_link in the forgot-password response.
